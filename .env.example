# Database
DATABASE_URL=postgres://biz:bizpassword@localhost:5432/biz_platform?sslmode=disable

# Object storage (S3-compatible: MinIO 로컬 / Cloudflare R2 또는 AWS S3 운영)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=bizadmin
STORAGE_SECRET_KEY=bizadminpassword
STORAGE_BUCKET=attachments

# 데이터 출처 (예시 - 실제 발급받은 키로 교체)
G2B_SERVICE_KEY=
BIZINFO_API_KEY=

# AI 설명 계층 (7단계에서 사용, 초기 단계는 비워둬도 무방)
ANTHROPIC_API_KEY=

# 결제 (토스페이먼츠 결제위젯 — 심사 승인 전엔 테스트 키 사용,
# https://developers.tosspayments.com/my/api-keys 에서 발급)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 이메일 알림 (Resend, https://resend.com/api-keys 에서 발급)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS 알림 (알리고, https://smartsms.aligo.in 에서 발급 — SENDER는
# 알리고 관리자 페이지에 사전 등록된 발신번호여야 함)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 세션 서명 키 (비워두면 프로세스 시작 시 랜덤 생성 — 재시작마다 세션이
# 끊기니 운영 배포에서는 반드시 값을 지정할 것)
SESSION_SECRET=

# 팀 초대 이메일 링크에 쓰이는 공개 URL(비워두면 localhost로 대체 —
# 운영 배포 시 반드시 실제 도메인으로 설정, 예: https://biz-platform-api.onrender.com)
# 간편로그인 콜백 URL(APP_BASE_URL + /api/auth/{provider}/callback)도
# 이 값을 그대로 쓰므로, 소셜 로그인을 쓰려면 각 서비스 개발자 콘솔에
# 등록하는 리다이렉트 URI도 반드시 이 도메인 기준으로 맞춰야 한다.
APP_BASE_URL=

# 간편로그인 — 구글 (https://console.cloud.google.com 에서 OAuth 클라이언트
# 생성, 승인된 리디렉션 URI에 {APP_BASE_URL}/api/auth/google/callback 등록)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 간편로그인 — 네이버 (https://developers.naver.com/apps 에서 애플리케이션
# 등록, Callback URL에 {APP_BASE_URL}/api/auth/naver/callback 등록)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 간편로그인 — 카카오 (https://developers.kakao.com 에서 애플리케이션 등록,
# REST API 키를 KAKAO_REST_API_KEY로 사용. Redirect URI에
# {APP_BASE_URL}/api/auth/kakao/callback 등록, 카카오 로그인 활성화 및
# 이메일 동의항목 필수로 설정 필요. KAKAO_CLIENT_SECRET은 "Client Secret
# 코드 사용"을 켰을 때만 필요한 선택 값)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
