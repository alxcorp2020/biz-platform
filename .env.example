# Database
DATABASE_URL=postgres://biz:bizpassword@localhost:5432/biz_platform?sslmode=disable

# Object storage (S3-compatible: MinIO 로컬 / Cloudflare R2 또는 AWS S3 운영)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=bizadmin
STORAGE_SECRET_KEY=bizadminpassword
STORAGE_BUCKET=attachments

# 데이터 출처 (예시 - 실제 발급받은 키로 교체)
G2B_SERVICE_KEY=
BIZINFO_API_KEY=

# AI 설명 계층 (7단계에서 사용, 초기 단계는 비워둬도 무방)
ANTHROPIC_API_KEY=

# 결제 (토스페이먼츠 결제위젯 — 심사 승인 전엔 테스트 키 사용,
# https://developers.tosspayments.com/my/api-keys 에서 발급)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 이메일 알림 (Resend, https://resend.com/api-keys 에서 발급)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS 알림 (알리고, https://smartsms.aligo.in 에서 발급 — SENDER는
# 알리고 관리자 페이지에 사전 등록된 발신번호여야 함)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=

# 세션 서명 키 (비워두면 프로세스 시작 시 랜덤 생성 — 재시작마다 세션이
# 끊기니 운영 배포에서는 반드시 값을 지정할 것)
SESSION_SECRET=

# 팀 초대 이메일 링크에 쓰이는 공개 URL(비워두면 localhost로 대체 —
# 운영 배포 시 반드시 실제 도메인으로 설정, 예: https://biz-platform-api.onrender.com)
APP_BASE_URL=
