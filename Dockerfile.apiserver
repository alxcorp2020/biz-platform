# syntax=docker/dockerfile:1
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY collector/go.mod collector/go.sum ./
RUN go mod download
COPY collector/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/apiserver ./cmd/apiserver

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/apiserver /apiserver
EXPOSE 8080
ENTRYPOINT ["/apiserver"]
