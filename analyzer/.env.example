# run_pipeline.sh가 읽는 로컬 전용 설정. 실제 값은 analyzer/.env로 복사해서 채운다
# (analyzer/.env는 루트 .gitignore의 ".env" 규칙에 의해 커밋되지 않는다).
#
# cron/launchd처럼 로그인 셸을 거치지 않는 스케줄러에서 실행할 때는 환경변수가
# 비어 있으므로, run_pipeline.sh가 이 파일을 직접 읽어서 채운다.

DATABASE_URL=postgres://biz:bizpassword@localhost:5432/biz_platform?sslmode=disable

# collector-daemon/apiserver를 collector/ 디렉터리에서 실행했을 때의 기본 저장
# 위치(collector/data/attachments) 기준 상대경로. 다른 위치에 저장했다면 맞춰 수정.
ATTACHMENT_DIR=../collector/data/attachments

# ai_extract.py(AI 기반 보완 추출, 2차), ai_summarize.py(핵심 3줄 요약) 전용.
# 둘 다 run_pipeline.sh 자동 파이프라인에는 포함되어 있지 않음 — 비용이 드는
# 단계라 항상 수동으로, 견적 확인 후 실행한다.
ANTHROPIC_API_KEY=
